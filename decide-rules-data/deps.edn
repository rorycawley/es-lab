{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.5"}
  metosin/malli       {:mvn/version "0.20.1"}}

 :aliases
 ;; `:dev` is the REPL-driven workflow the README describes: it puts dev/ and
 ;; test/ on the classpath so dev/decider/playground.clj can be evaluated form
 ;; by form. test.check is here because malli.generator needs it.
 {:dev
  {:extra-paths ["dev" "test"]
   :extra-deps
   {org.clojure/test.check {:mvn/version "1.1.3"}}}

  ;; Kaocha rather than a hand-written runner: it discovers every `*-test`
  ;; namespace under test/, so adding a test file is adding a file and nothing
  ;; else. A runner that names its namespaces is one more place to forget.
  :test
  {:extra-paths ["test"]
   :extra-deps
   {org.clojure/test.check {:mvn/version "1.1.3"}
    lambdaisland/kaocha    {:mvn/version "1.91.1392"}}
   :main-opts ["-m" "kaocha.runner"]}}}
