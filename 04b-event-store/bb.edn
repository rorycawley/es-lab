{:paths ["."]
 :tasks
 {:requires ([babashka.process :refer [shell]]
             [clojure.string :as str])

  :init (do
          (defn sh [& args]
            (binding [*out* *err*]
              (apply println "+" (remove map? args)))
            (apply shell args))

          (defn docker-env []
            (let [docker-host (System/getenv "DOCKER_HOST")
                  host-ip     (or (System/getenv "TESTCONTAINERS_HOST_OVERRIDE")
                                  (try (str/trim (:out (shell {:out :string :continue true}
                                                              "rdctl" "info" "--field" "ip-address")))
                                       (catch Exception _ nil)))]
              (cond-> {"TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE" "/var/run/docker.sock"}
                docker-host              (assoc "DOCKER_HOST" docker-host)
                (not (str/blank? host-ip)) (assoc "TESTCONTAINERS_HOST_OVERRIDE" host-ip))))

          (def local-postgres-env
            {"JDBC_URL"    "jdbc:postgresql://localhost:5432/event_store"
             "DB_USERNAME" "cart_app"
             "DB_PASSWORD" "cart_app"})

          (def local-sqlite-env
            {"CART_STORE"        "sqlite"
             "SQLITE_JDBC_URL"  "jdbc:sqlite:target/cart-event-store.sqlite3"
             "SQLITE_POOL_SIZE" "4"}))

  help
  {:doc              "Show setup prerequisites and available tasks"
   :override-builtin true
   :task
   (do (println "")
       (println "Prerequisites:")
       (println "  1. Install mise: curl https://mise.run | sh")
       (println "  2. Run: bb install")
       (println "  3. Docker running (Postgres adapter tests only)")
       (println "")
       (println "Then:")
       (println "  bb tasks       list all tasks")
       (println "  bb precommit   local no-Docker gate before committing")
       (println "  bb ci          full CI gate, including Postgres 18.4 via Testcontainers")
       (println "  bb test:business-logic pure core invariants. fast, no Docker.")
       (println "  bb test:unit   primary unit tests through command/query ports. fast, no Docker.")
       (println "  bb test:outbound-sqlite SQLite EventStore contract tests. fast, no Docker.")
       (println "  bb test:http-contract HTTP adapter + OpenAPI contract tests")
       (println "  bb test:http-perf HTTP performance smoke tests")
       (println "  bb test        full suite, including Postgres 18.4 via Testcontainers")
       (println "  bb up          start Postgres, run Flyway, then start the HTTP API")
       (println "  bb down        stop local containers, remove the DB volume, clean artefacts")
       (println "  bb db:up       start the local Postgres container")
       (println "  bb migrate     run Flyway in its own one-shot container")
       (println "  bb run:memory  start the HTTP API with the in-memory store")
       (println "  bb run:sqlite  start the HTTP API with a local SQLite file")
       (println "  bb run         start the HTTP API with Postgres; needs JDBC_URL")
       (println "  bb db:down     stop local containers and remove the dev volume")
       (println "")
       (println "Start here:")
       (println "  SPEC.md        what this project must do, and why")
       (println "")
       (println "Rancher Desktop users — one-time machine setup for adapter tests:")
       (println "  Testcontainers needs the socket at ~/.rd/docker.sock and API >= 1.41,")
       (println "  but docker-java defaults to 1.32. Create these two files:")
       (println "")
       (println "  ~/.docker-java.properties")
       (println "    api.version=1.44")
       (println "")
       (println "  ~/.testcontainers.properties")
       (println "    docker.host=unix:///Users/$USER/.rd/docker.sock")
       (println "    ryuk.disabled=true")
       (println "    checks.disable=true")
       (println "")
       (println "  Also ensure Rancher Desktop uses dockerd (moby), not containerd.")
       (println ""))}

  install
  {:doc  "Install pinned tools via mise"
   :task (sh "mise" "install")}

  test:business-logic
  {:doc  "Run pure domain behavior and aggregate invariant tests"
   :task (sh "clojure" "-M:test" "--focus" ":business-logic")}

  test:serialisation
  {:doc  "Run event storage JSON serialisation boundary tests"
   :task (sh "clojure" "-M:test" "--focus" ":boundary-serialisation")}

  test:unit
  {:doc  "Run primary unit tests through inbound command/query/integration-event ports"
   :task (sh "clojure" "-M:test" "--focus" ":unit")}

  test:outbound-memory
  {:doc  "Run in-memory EventStore outbound port contract tests"
   :task (sh "clojure" "-M:test" "--focus" ":outbound-memory")}

  test:outbound-sqlite
  {:doc  "Run SQLite EventStore outbound port contract tests (no Docker needed)"
   :task (sh "clojure" "-M:test" "--focus" ":outbound-sqlite")}

  test:outbound-postgres
  {:doc  "Run Postgres SQL and EventStore outbound port tests"
   :task (sh {:extra-env (docker-env)}
             "clojure"
             "-M:test"
             "--focus"
             ":outbound-postgres")}

  test:http-contract
  {:doc  "Run HTTP driving adapter and OpenAPI contract tests (no Docker needed)"
   :task (sh "clojure" "-M:test" "--focus" ":http-contract")}

  test:component-lifecycle
  {:doc  "Run Component lifecycle and memory-backed Jetty smoke tests"
   :task (sh "clojure" "-M:test" "--focus" ":component-lifecycle")}

  test:http-perf
  {:doc  "Run HTTP performance smoke tests (no Docker needed)"
   :task (sh "clojure" "-M:test" "--focus" ":http-perf")}

  test:system-sqlite
  {:doc  "Run HTTP system smoke tests with SQLite (no Docker needed)"
   :task (sh "clojure" "-M:test" "--focus" ":system-sqlite")}

  test:system-postgres
  {:doc  "Run HTTP system smoke tests with Postgres/Flyway/Testcontainers"
   :task (sh {:extra-env (docker-env)}
             "clojure"
             "-M:test"
             "--focus"
             ":system-postgres")}

  test:fast
  {:doc  "Run all no-Docker test suites"
   :depends [test:business-logic
             test:serialisation
             test:unit
             test:outbound-memory
             test:outbound-sqlite
             test:http-contract
             test:component-lifecycle
             test:system-sqlite]}

  precommit
  {:doc  "Run the local no-Docker gate before committing"
   :depends [check test:fast]}

  test:postgres
  {:doc  "Run all Postgres/Flyway/Testcontainers tests"
   :depends [test:outbound-postgres test:system-postgres]}

  test:outbound
  {:doc  "Run outbound adapter contract tests, including Postgres"
   :depends [test:outbound-memory test:outbound-sqlite test:outbound-postgres]}

  test:adapters
  {:doc  "Run adapter, component and system tests, including Postgres"
   :depends [test:outbound test:http-contract test:component-lifecycle
             test:system-sqlite test:system-postgres]}

  test:core
  {:doc  "Alias: run domain business-logic and serialisation boundary tests"
   :depends [test:business-logic test:serialisation]}

  test:app
  {:doc  "Alias: run primary unit tests through inbound ports"
   :depends [test:unit]}

  test:memory
  {:doc  "Alias: run in-memory EventStore outbound port contract tests"
   :depends [test:outbound-memory]}

  test:sqlite
  {:doc  "Alias: run SQLite outbound adapter and SQLite system smoke tests"
   :depends [test:outbound-sqlite test:system-sqlite]}

  test:http
  {:doc  "Alias: run HTTP contract and component lifecycle tests"
   :depends [test:http-contract test:component-lifecycle]}

  test:perf
  {:doc  "Alias: run HTTP performance smoke tests"
   :depends [test:http-perf]}

  test:adapter
  {:doc  "Alias: run adapter, component and system tests"
   :depends [test:adapters]}

  test
  {:doc  "Run the whole suite (requires Docker)"
   :task (sh {:extra-env (docker-env)} "clojure" "-M:test")}

  ci
  {:doc  "Run the full CI gate"
   :depends [check test]}

  repl
  {:doc              "Start a REPL with dev and test paths"
   :override-builtin true
   :task (sh "clojure" "-M:dev:test" "-r")}

  run
  {:doc  "Run the HTTP API with Postgres (requires JDBC_URL, optional DB_USERNAME/DB_PASSWORD)"
   :override-builtin true
   :task (sh "clojure" "-M:run")}

  run:memory
  {:doc  "Run the HTTP API with the in-memory store"
   :task (sh {:extra-env {"CART_STORE" "memory"}} "clojure" "-M:run")}

  run:sqlite
  {:doc  "Run the HTTP API with a local SQLite file"
   :task (sh {:extra-env local-sqlite-env} "clojure" "-M:run")}

  up
  {:doc  "Start local Postgres, migrate it, then run the HTTP API with Postgres"
   :task (do
           (sh "docker" "compose" "up" "-d" "postgres")
           (sh "docker" "compose" "run" "--rm" "flyway")
           (println "Cart HTTP service will use local Postgres on http://localhost:8080")
           (sh {:extra-env local-postgres-env} "clojure" "-M:run"))}

  db:up
  {:doc  "Start local Postgres for the HTTP API"
   :task (sh "docker" "compose" "up" "-d" "postgres")}

  migrate
  {:doc  "Run Flyway in a one-shot container against local Compose Postgres"
   :task (sh "docker" "compose" "run" "--rm" "flyway")}

  db:down
  {:doc  "Stop local Compose containers and remove the dev database volume"
   :task (sh "docker" "compose" "down" "-v")}

  down
  {:doc  "Stop local Compose containers, remove the dev database volume, clean artefacts"
   :task (do
           (sh "docker" "compose" "down" "-v" "--remove-orphans")
           (sh "rm" "-rf" "target" ".cpcache"))}

  check:lint
  {:doc  "Lint with clj-kondo"
   :task (sh "mise" "exec" "--" "clj-kondo" "--parallel" "--lint" "src:test")}

  check:fmt
  {:doc  "Check formatting with cljfmt"
   :task (sh "mise" "exec" "--" "cljfmt" "check" "src" "test")}

  check:whitespace
  {:doc  "Check git diff whitespace errors"
   :task (sh "git" "diff" "--check")}

  check
  {:doc     "Lint and check formatting"
   :depends [check:lint check:fmt check:whitespace]}

  fix
  {:doc  "Fix formatting"
   :task (sh "mise" "exec" "--" "cljfmt" "fix" "src" "test")}

  clean
  {:doc  "Remove build artefacts"
   :task (sh "rm" "-rf" "target" ".cpcache")}

  all
  {:doc     "Install tools and run everything"
   :depends [install check test]}}}
