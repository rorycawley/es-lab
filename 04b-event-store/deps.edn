{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure                     {:mvn/version "1.12.0"}

  ;; Schemas (used by the shell and tests only, never by cart.core)
  metosin/malli                           {:mvn/version "0.16.4"}

  ;; Database
  com.github.seancorfield/next.jdbc       {:mvn/version "1.3.939"}
  org.postgresql/postgresql               {:mvn/version "42.7.3"}
  com.zaxxer/HikariCP                     {:mvn/version "5.1.0"}

  ;; Migrations
  org.flywaydb/flyway-core                {:mvn/version "12.6.2"}
  org.flywaydb/flyway-database-postgresql {:mvn/version "12.6.2"}

  ;; Serialisation
  com.cognitect/transit-clj               {:mvn/version "1.0.333"}

  ;; Logging
  org.slf4j/slf4j-simple                  {:mvn/version "2.0.16"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps  {lambdaisland/kaocha               {:mvn/version "1.91.1392"}
                 org.clojure/test.check            {:mvn/version "1.1.1"}
                 org.testcontainers/testcontainers {:mvn/version "1.20.4"}
                 org.testcontainers/postgresql     {:mvn/version "1.20.4"}}
   :main-opts   ["-m" "kaocha.runner"]}

  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps  {org.clojure/tools.namespace {:mvn/version "1.4.4"}}}}}
