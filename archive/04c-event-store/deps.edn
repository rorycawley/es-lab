{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure               {:mvn/version "1.12.0"}

  ;; Application boundaries and transport
  aero/aero                         {:mvn/version "1.1.6"}
  cheshire/cheshire                 {:mvn/version "5.13.0"}
  com.stuartsierra/component        {:mvn/version "1.2.0"}
  metosin/reitit-ring               {:mvn/version "0.10.1"}
  ring/ring-core                    {:mvn/version "1.15.5"}
  ring/ring-jetty-adapter           {:mvn/version "1.15.5"}

  ;; Persistence dependencies are pinned now; adapters arrive in Iteration 1.
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.939"}
  com.zaxxer/HikariCP               {:mvn/version "5.1.0"}
  org.flywaydb/flyway-core          {:mvn/version "13.0.0"}
  org.postgresql/postgresql         {:mvn/version "42.7.3"}
  org.xerial/sqlite-jdbc            {:mvn/version "3.53.2.0"}

  org.slf4j/slf4j-simple            {:mvn/version "2.0.16"}}

 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps  {com.atlassian.oai/openapi-request-validator-core {:mvn/version "3.0.0"}
                 io.swagger.parser.v3/swagger-parser              {:mvn/version "2.1.41"}
                 lambdaisland/kaocha                              {:mvn/version "1.91.1392"}
                 nubank/matcher-combinators                       {:mvn/version "3.9.1"}
                 org.testcontainers/postgresql                    {:mvn/version "1.20.4"}
                 org.testcontainers/testcontainers                {:mvn/version "1.20.4"}}
   :main-opts   ["-m" "kaocha.runner"]}

  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps  {org.clojure/tools.namespace {:mvn/version "1.5.0"}}}

  :run
  {:main-opts ["-m" "cart-backend.main"]}

  :migrate
  {:main-opts ["-m" "platform.persistence.migrations"]}}}
